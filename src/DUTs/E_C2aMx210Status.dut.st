// Назначение: состояние измерения МВ210-101 по коду ошибки в регистре значения (РЭ МВ210-101 v1.41,
//             табл. 6.9, с. 36). Положение кода в регистрах FLOAT32/INT16 по РЭ однозначно не следует — сверить
//             на модуле (docs/HARDWARE_VALIDATION.md).
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/IO.md
{attribute 'qualified_only'}
TYPE E_C2aMx210Status :
(
    Ok := 0,                // передаётся результат измерения
    Invalid := 16#F0,       // значение заведомо неверно
    NotReady := 16#F6,      // данные не готовы
    SensorOff := 16#F7,     // датчик отключён
    ColdJunctionHigh := 16#F8,  // велика температура свободных концов ТП
    ColdJunctionLow := 16#F9,   // мала температура свободных концов ТП
    TooHigh := 16#FA,       // значение слишком велико
    TooLow := 16#FB,        // значение слишком мало
    ShortCircuit := 16#FC,  // короткое замыкание датчика
    SensorBreak := 16#FD,   // обрыв датчика
    AdcFailure := 16#FE,    // нет связи с АЦП
    BadCalibration := 16#FF // некорректный калибровочный коэффициент
) BYTE;
END_TYPE
