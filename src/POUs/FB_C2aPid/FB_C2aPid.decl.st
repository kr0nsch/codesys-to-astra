// Назначение: интерфейс STD_PID CmpOwenPidRegs (документ ОВЕН v2.2, с. 10–11) поверх Util.PID. Алгоритм
//             другой: XP — полоса пропорциональности (Kp = 1/XP в единицах выхода −1..1, п. 3.2), TI/TD — с;
//             XN (зона нечувствительности), VSP (скорость уставки), INF (фильтр), PV_TIME не повторяются.
//             Поэтому замена всегда «сверить» (check); автонастройка — todo.
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/LIBMAP.md
FUNCTION_BLOCK FB_C2aPid
VAR_INPUT
    Y_MANUAL : REAL;    // выход в ручном режиме (PMIN..PMAX)
    Y_MAN_SET : BOOL;   // TRUE — ручной режим
    PV : REAL;          // измеренное значение
    PV_TIME : WORD;     // время обновления PV, 0.01 с (не используется)
    SP : REAL;          // уставка
    XN : REAL;          // зона нечувствительности (не используется)
    PMIN : REAL;        // нижняя граница выхода
    PMAX : REAL;        // верхняя граница выхода
    XP : REAL;          // полоса пропорциональности, ед. регулируемой величины
    TI : REAL;          // постоянная интегрирования, с
    TD : REAL;          // постоянная дифференцирования, с
    VSP : REAL;         // ограничение скорости уставки (не используется)
    INF : REAL;         // постоянная входного фильтра (не используется)
END_VAR
VAR_OUTPUT
    Y : REAL;           // выход PMIN..PMAX
END_VAR
VAR
    fbPid : Util.PID;   // ПИД Util CODESYS (TI > 0)
    fbPd : Util.PD;     // ПД Util CODESYS (TI = 0)
    rY : REAL;          // выход выбранного регулятора
    rKp : REAL;         // коэффициент пропорциональности
END_VAR
