            <variable name="SLOPE">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="-1.2" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> наклон графика, °C/°C</xhtml>
              </documentation>
            </variable>
            <variable name="SP_MIN">
