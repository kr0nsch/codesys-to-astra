          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">F_HeatingCurve := LIMIT(SP_MIN, rSpBase_C + SLOPE * rTOutdoor_C, SP_MAX);
