            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="PRG_Main" pouType="program">
        <interface>
          <localVars>
            <variable name="fbPid">
              <type>
                <derived name="OPR.STD_PID" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> ПИД подачи</xhtml>
              </documentation>
            </variable>
            <variable name="rSp_C">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> уставка подачи, °C</xhtml>
              </documentation>
            </variable>
            <variable name="rValve">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> выход ПИД 0..1</xhtml>
              </documentation>
            </variable>
            <variable name="fbRunTimer">
              <type>
                <derived name="TON" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> секундный такт наработки</xhtml>
              </documentation>
            </variable>
          </localVars>
          <localVars constant="true">
            <variable name="XP_C">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="20.0" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> полоса пропорциональности, °C</xhtml>
              </documentation>
            </variable>
            <variable name="TI_S">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="120.0" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> постоянная интегрирования, с</xhtml>
              </documentation>
            </variable>
            <variable name="T_SECOND">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="T#1S" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> такт счёта наработки</xhtml>
              </documentation>
            </variable>
            <variable name="DIGITS">
              <type>
                <USINT />
              </type>
              <initialValue>
                <simpleValue value="1" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> знаков после запятой</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"> Назначение: регулирование подачи (ПИД CmpOwenPidRegs), насос, строки для панели (OwenStringUtils).
 Автор:      kr0nsch
 Версия:     0.1.0
 Документ:   corpus/boiler-plc210/README.md</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">rSp_C := F_HeatingCurve(GVL_Mx.rTOutdoor_C, GVL_Persist.rSpBase_C);
fbPid(PV := GVL_Mx.rTSupply_C, SP := rSp_C, XP := XP_C, TI := TI_S, TD := 0.0, PMIN := 0.0, PMAX := 1.0,
      Y_MAN_SET := FALSE, Y_MANUAL := 0.0);
rValve := fbPid.Y;
IF GVL_Hmi.eState &lt;&gt; E_BoilerState.Fault THEN
    GVL_Hmi.eState := E_BoilerState.Run;
END_IF
GVL_Hw.xPumpRun := GVL_Hmi.eState = E_BoilerState.Run;
GVL_Mx.wDoMask := SEL(GVL_Hw.xPumpRun, 16#0000, 16#0001);
fbRunTimer(IN := GVL_Hw.xPumpRun AND NOT fbRunTimer.Q, PT := T_SECOND);
IF fbRunTimer.Q THEN
    GVL_Persist.udiRunTime_s := GVL_Persist.udiRunTime_s + 1;
END_IF
GVL_Hmi.sStatus := OSU.CONCAT4('T=', OSU.REAL_TO_STRING_FORMAT(GVL_Mx.rTSupply_C, DIGITS, OSU.DECIMAL_SEPARATOR.COMMA),
                               ' C, SP=', OSU.REAL_TO_STRING_FORMAT(rSp_C, DIGITS, OSU.DECIMAL_SEPARATOR.COMMA));
GVL_Hmi.sCode := OSU.WORD_TO_HEX_STR(wInput := GVL_Hw.wHmiStatus, xUpperCase := TRUE, sPrefix := '0x');
</xhtml>
          </ST>
        </body>
